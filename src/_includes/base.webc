<!doctype html>
<html :lang="lang" :data-lang="lang">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title @text="i18n[lang].meta.title">DNS Mesh Protocol</title>
  <meta name="description" :content="i18n[lang].meta.description">
  <meta name="color-scheme" content="dark">

  <link rel="alternate" hreflang="en" :href="`${site.url}${basePath}en/`">
  <link rel="alternate" hreflang="es" :href="`${site.url}${basePath}es/`">
  <link rel="alternate" hreflang="x-default" :href="`${site.url}${basePath}en/`">
  <link rel="canonical" :href="`${site.url}${page.url}`">
  <link rel="icon" type="image/svg+xml" :href="`${basePath}favicon.svg`">

  <link webc:keep rel="preconnect" href="https://fonts.googleapis.com">
  <link webc:keep rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link webc:keep rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=JetBrains+Mono:wght@400;500&display=swap">
  <link webc:keep rel="stylesheet" :href="`${basePath}styles.css?v=27`">
</head>
<body>
  <a class="skip-link" href="#main" @text="i18n[lang].nav.skipToContent"></a>

  <nav class="navbar navbar--island" :aria-label="i18n[lang].nav.ariaLabel">
    <div class="navbar-island">

      <a class="island-brand" :href="`${basePath}${lang}/`">
        <span class="island-brand-mark" aria-hidden="true"></span>
        <span class="island-brand-name">DNSMesh</span>
      </a>

      <span class="island-divider" aria-hidden="true"></span>

      <div class="island-steps">
        <a class="island-step" href="#protocol" @text="i18n[lang].nav.protocol"></a>
        <a class="island-step" href="#try" @text="i18n[lang].nav.try"></a>
        <span class="island-indicator" aria-hidden="true"></span>
      </div>

      <span class="island-divider" aria-hidden="true"></span>

      <div class="island-links">
        <a class="island-link" :href="site.spec" target="_blank" rel="noopener" @text="i18n[lang].nav.spec"></a>
        <a class="island-link" :href="site.directory" target="_blank" rel="noopener" @text="i18n[lang].nav.directory"></a>
        <a class="island-link" :href="site.github" target="_blank" rel="noopener" @text="i18n[lang].nav.github"></a>
      </div>

      <span class="island-divider" aria-hidden="true"></span>

      <div class="island-actions">
        <details class="lang-switcher" :aria-label="i18n[lang].lang.label">
          <summary class="lang-toggle" :aria-label="i18n[lang].lang.toggleAriaLabel">
            <span class="lang-toggle-code" @text="lang === 'en' ? 'EN' : 'ES'"></span>
            <span class="lang-toggle-chevron" aria-hidden="true">
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                <path d="M2 4 L5 7 L8 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </summary>
          <div class="lang-panel" role="menu">
            <a class="lang-option" :href="`${basePath}en/`" lang="en" hreflang="en" role="menuitem"
               :aria-current="lang === 'en' ? 'page' : false">English</a>
            <a class="lang-option" :href="`${basePath}es/`" lang="es" hreflang="es" role="menuitem"
               :aria-current="lang === 'es' ? 'page' : false">Español</a>
          </div>
        </details>
        <button type="button"
                class="island-hamburger"
                aria-controls="island-menu"
                aria-expanded="false"
                :aria-label="i18n[lang].nav.menuOpen">
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>

      <div id="island-menu"
           class="island-menu"
           :aria-label="i18n[lang].nav.menuLabel"
           aria-hidden="true">
        <a class="island-menu-item" href="#protocol" @text="i18n[lang].nav.protocol"></a>
        <a class="island-menu-item" href="#try" @text="i18n[lang].nav.try"></a>
        <a class="island-menu-item" :href="site.spec" target="_blank" rel="noopener" @text="i18n[lang].nav.spec"></a>
        <a class="island-menu-item" :href="site.directory" target="_blank" rel="noopener" @text="i18n[lang].nav.directory"></a>
        <a class="island-menu-item" :href="site.github" target="_blank" rel="noopener" @text="i18n[lang].nav.github"></a>
        <div class="island-menu-langs" role="group" :aria-label="i18n[lang].lang.label">
          <a class="island-menu-lang" :href="`${basePath}en/`" lang="en" hreflang="en"
             :aria-current="lang === 'en' ? 'page' : false">English</a>
          <a class="island-menu-lang" :href="`${basePath}es/`" lang="es" hreflang="es"
             :aria-current="lang === 'es' ? 'page' : false">Español</a>
        </div>
      </div>

    </div>
  </nav>

  <main id="main" @html="content"></main>

  <footer class="site-footer" role="contentinfo">
    <div class="container">
      <div class="footer-top">
        <div class="footer-brand">
          <a :href="`${basePath}${lang}/`" class="footer-brand-link">
            <span class="footer-brand-mark" aria-hidden="true"></span>
            <span class="footer-brand-name">DNSMesh</span>
          </a>
          <p class="footer-tagline" @text="i18n[lang].footer.tagline"></p>
        </div>

        <nav class="footer-nav" :aria-label="i18n[lang].footer.navAriaLabel">
          <a href="#protocol" @text="i18n[lang].nav.protocol"></a>
          <a href="#try" @text="i18n[lang].nav.try"></a>
          <a :href="site.spec" target="_blank" rel="noopener" @text="i18n[lang].nav.spec"></a>
          <a :href="site.directory" target="_blank" rel="noopener" @text="i18n[lang].nav.directory"></a>
          <a :href="site.github" target="_blank" rel="noopener" @text="i18n[lang].nav.github"></a>
        </nav>

        <div class="footer-contact">
          <a :href="site.support" target="_blank" rel="noopener noreferrer" @text="i18n[lang].footer.support"></a>
          <a :href="site.phoneHref" class="footer-phone" @text="site.phone"></a>
        </div>
      </div>

      <div class="footer-bottom">
        <p class="footer-legal"
           @text="i18n[lang].footer.copyright.replace('{year}', site.year).replace('{company}', site.company).replace('{locations}', site.companyLocations)"></p>
        <p class="footer-license" @text="i18n[lang].footer.license"></p>
        <nav class="footer-legal-links" :aria-label="i18n[lang].footer.legalAriaLabel">
          <a href="#" @text="i18n[lang].footer.privacy"></a>
          <a href="#" @text="i18n[lang].footer.terms"></a>
        </nav>
      </div>
    </div>
  </footer>

  <script webc:keep :src="`${basePath}assets/js/navbar.js`" defer></script>
</body>
</html>
